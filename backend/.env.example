APP_NAME="Cargo Motives"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS (TRD §1, §9). Matches docker-compose's "postgres" service.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cargo_motives
DB_USERNAME=cargo_motives
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The Admin tool (Phase 9) is session-cookie authenticated. Leave false for
# local dev (no TLS); production MUST set this true, or the session cookie
# is sent over any accidental plain-HTTP request too (TRD §7: "all traffic
# over HTTPS").
SESSION_SECURE_COOKIE=false

# Comma-separated proxy IP(s), or '*' to trust any (only when the app is
# ONLY ever reachable through that proxy, e.g. a managed platform's own
# load balancer — never set '*' if the app is also directly reachable).
# Empty/unset (correct for local dev) means Laravel trusts no proxy at
# all and $request->secure() reflects the raw connection only. Needed in
# production behind any TLS-terminating load balancer — see
# bootstrap/app.php's trustProxies() call.
TRUSTED_PROXIES=

# Reverb is the one WebSocket service, used only for live GPS + live bids (TRD §4).
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Predis (pure-PHP client) rather than the phpredis extension, so the app
# runs identically whether or not the phpredis PHP extension is installed —
# one less thing that has to match between local/dev/CI/prod images.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = writes the rendered email to storage/logs/laravel.log instead of
# sending (used for the Customer email-OTP flow, Phase 10.5). Switch to smtp
# with a real provider (Gmail SMTP works for low volume; Postmark/SES for
# production) before relying on delivery — never commit real credentials
# here, only in the gitignored .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@cargomotives.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage — MinIO locally, a real S3-compatible bucket in
# staging/production (TRD §1, §7). Verification documents and proof-of-delivery
# photos live in a private bucket; the app only ever hands out signed URLs.
AWS_ACCESS_KEY_ID=cargo_motives
AWS_SECRET_ACCESS_KEY=secretsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cargo-motives-local
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Cargo Motives third-party services (TRD §12) ---

# SMS gateway — OTP + Driver Link delivery only (TRD §1, §7). SMS_DRIVER=log
# writes the message to the log instead of sending it, so local dev and CI
# never depend on a live SMS account. Swap to a real driver (e.g. "beem",
# "africastalking") once a provider is chosen — see App\Services\Sms.
SMS_DRIVER=log
SMS_SENDER_ID="CargoMotives"
BEEM_API_KEY=
BEEM_SECRET_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Push notifications (FCM) — key events per AppFlow §6. "log" writes the
# push to the log instead of sending (see config/fcm.php); switch to
# "firebase" once the two vars below point at a real Firebase project.
PUSH_DRIVER=log
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Maps — Google Maps (pins, live tracking, geocoding).
GOOGLE_MAPS_API_KEY=

# Mobile money aggregator — Selcom. Commission + Featured payments (TRD §1, §7).
# Webhooks are signature-verified and processed idempotently keyed on
# gateway_reference (TRD §7, Backend Schema §2.14/§4.8).
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_BASE_URL=https://apigwtest.selcommobile.com
SELCOM_WEBHOOK_SECRET=

# GPS providers (TRD §5). Concrete, per-provider config — not a generic
# multi-provider framework. Wialon is the first provider integrated (Phase 6);
# Traccar/Tracksolid Pro follow once Wialon works end to end.
WIALON_TOKEN=
WIALON_BASE_URL=https://hst-api.wialon.com

# Error monitoring (TRD §10).
SENTRY_LARAVEL_DSN=
