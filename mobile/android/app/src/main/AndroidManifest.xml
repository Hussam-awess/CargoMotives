<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phase 10 audit finding: this was present only in the debug/profile
         manifests (Flutter's own scaffold default), never here in main —
         a release build merges main + the release variant only, so a
         real release APK/AAB would have shipped with every network call
         silently failing. Every REST call, the WebSocket connection, and
         Firebase all need this. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33+) requires this manifest declaration before
         FirebaseMessaging.requestPermission() can even prompt the user —
         without it, every notification is silently dropped on a 13+
         device/emulator regardless of anything else being configured
         correctly. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Cargo Motives"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Identity Sheet v2, "11 — Notification branding": a simplified
             white silhouette of the CM mark (drawable-*dpi/ic_stat_cargo_motives),
             not the full-colour launcher icon — Android requires a
             single-colour, alpha-only image here and silently renders a
             plain white square/blob if given a colourful one instead. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_cargo_motives" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
