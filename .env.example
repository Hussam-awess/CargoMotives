# Root-level env — only what docker-compose.yml itself reads (service
# credentials/ports for local dev). The Laravel app's own configuration
# lives in backend/.env (see backend/.env.example), which is separate on
# purpose: docker-compose orchestrates containers, backend/.env configures
# the app running inside one of them — they shouldn't be conflated.
#
# Copy to .env and adjust if needed; the defaults below match what
# backend/.env.example expects out of the box.

DB_DATABASE=cargo_motives
DB_USERNAME=cargo_motives
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

FORWARD_REDIS_PORT=6379

MINIO_ROOT_USER=cargo_motives
MINIO_ROOT_PASSWORD=secretsecret
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

FORWARD_APP_PORT=8000
FORWARD_REVERB_PORT=8080
